```{=html}
<%
const base = ((templateParams && templateParams.base) || "trabalhos").replace(/^\/|\/$/g, "");
const isAbs = (h) => /^([a-z]+:|#|\/\/)/i.test(h || "");
const toRel = (p) => {
  if (!p) return "";
  if (isAbs(p)) return p;
  p = String(p).replace(/^\//, "");
  if (base && p.startsWith(base + "/")) p = p.slice(base.length + 1);
  return p;
};
const esc = (s) => String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
%>
<div class="list cn-works">
<% for (const item of items) {
  const link = item.pagina === false ? "" : toRel(item.outputHref || item.path);
  const dir = toRel(item.path).replace(/[^/]*$/, "");
  const rel = (h) => isAbs(h) ? h : (String(h).startsWith("/") ? toRel(h) : dir + h);
  const img = item.image ? toRel(item.image) : "";
%>
<article class="cn-work" <%= metadataAttrs(item) %>>
  <% if (img) { %>
  <a class="cn-work-thumb" href="<%- link || '#' %>" tabindex="-1" aria-hidden="true"><img src="<%- img %>" alt="<%- esc(item['image-alt'] || '') %>" loading="lazy"></a>
  <% } else { %>
  <a class="cn-work-thumb cn-empty" href="<%- link || '#' %>" tabindex="-1" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle fill="var(--cn-d1)" cx="4" cy="4" r="3.3"/><circle fill="var(--cn-d2)" cx="12" cy="4" r="3.3"/><circle fill="var(--cn-d3)" cx="20" cy="4" r="3.3"/><circle fill="var(--cn-d2)" cx="4" cy="12" r="3.3"/><circle fill="var(--cn-d3)" cx="12" cy="12" r="3.3"/><circle fill="var(--cn-d4)" cx="20" cy="12" r="3.3"/><circle fill="var(--cn-d3)" cx="4" cy="20" r="3.3"/><circle fill="var(--cn-d4)" cx="12" cy="20" r="3.3"/><circle fill="var(--cn-d5)" cx="20" cy="20" r="3.3"/></svg></a>
  <% } %>
  <div class="cn-work-body">
    <p class="cn-eyebrow"><span class="cn-chip cn-chip-accent"><%= item.tipo || "Trabalho" %></span><% if (item.date) { %><time><%= item.date %></time><% } %></p>
    <h3 class="cn-work-title anchored"><% if (link) { %><a href="<%- link %>"><%= item.title %></a><% } else { %><%= item.title %><% } %></h3>
    <% if (item.description) { %><p class="cn-work-teaser"><%= item.description %></p><% } %>
    <% const tags = [].concat(item.metodos || []), dados = [].concat(item.dados || []); if (tags.length || dados.length) { %>
    <ul class="cn-tags">
      <% for (const t of tags) { %><li class="cn-chip"><%= t %></li><% } %>
      <% for (const t of dados) { %><li class="cn-chip cn-chip-data"><%= t %></li><% } %>
    </ul>
    <% } %>
    <p class="cn-actions">
      <% if (link) { %><a class="cn-primary" href="<%- link %>">Ler online</a><% } %>
      <% for (const m of [].concat(item.materiais || [])) { if (!m || !m.href) continue; %><a href="<%- rel(m.href) %>"><%= m.text %></a><% } %>
    </p>
  </div>
</article>
<% } %>
</div>
```
